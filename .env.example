# Your personal Telegram account (Telethon reads the channels as you)
TELEGRAM_API_ID=replace_with_your_api_id
TELEGRAM_API_HASH=replace_with_your_api_hash

# News bot: posts mobilization updates into the public channel
NEWS_BOT_TOKEN=replace_with_your_news_bot_token
NEWS_CHAT_ID=replace_with_your_channel_id

# Alert bot: DMs you about errors and downtime
ALERT_BOT_TOKEN=replace_with_your_alert_bot_token
ALERT_CHAT_ID=replace_with_your_private_chat_id

# Dead man's switch: healthchecks.io ping URL
HEALTHCHECK_URL=replace_with_your_healthchecks_ping_url

LLM_API_KEY=replace_with_your_gemini_key
