[Unit]
Description=News Tracker
After=network.target
OnFailure=news-tracker-alert@%n.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/news-tracker
ExecStart=/home/ubuntu/news-tracker/.venv/bin/python -u main.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
